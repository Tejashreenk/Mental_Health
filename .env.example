# ── Sensitive values — NEVER commit this file to version control ──────────────

# Application
APP_NAME="Mental Health AI Recommendation Engine"
ENVIRONMENT="development"
DEBUG=true

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="REPLACE_WITH_A_STRONG_RANDOM_SECRET"

# Database (SQLite for dev; swap for PostgreSQL in production)
DATABASE_URL="sqlite+aiosqlite:///./mental_health.db"

# Redis (optional — comment out if not using caching)
# REDIS_URL="redis://localhost:6379/0"

# NLP Models (HuggingFace model IDs)
SENTIMENT_MODEL="cardiffnlp/twitter-roberta-base-sentiment-latest"
EMOTION_MODEL="j-hartmann/emotion-english-distilroberta-base"
INTENT_MODEL="facebook/bart-large-mnli"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Recommendation Engine
CONTENT_WEIGHT=0.6
COLLABORATIVE_WEIGHT=0.4
TOP_K_RECOMMENDATIONS=5

# Crisis Detection
CRISIS_SCORE_THRESHOLD=0.75
CRISIS_HOTLINE="988"
CRISIS_TEXT_LINE="Text HOME to 741741"
